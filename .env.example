# Copy to .env for local runs. On Vercel, add these under Project → Settings →
# Environment Variables instead (never commit real values).

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" (port 6543) for Vercel; the
# "Session pooler" (port 5432) is fine locally. URL-encode special characters
# in the password (@ → %40). Leave empty locally to use a throwaway in-memory DB.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Long random string: `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public address of the app, no trailing slash (e.g. https://tena.co.ke).
# On Vercel it defaults to the production domain if left unset.
BETTER_AUTH_URL=http://localhost:8080

# Optional Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_AUTH_ENABLED=false

# ── Tena HQ (/ops) ───────────────────────────────────────────────────────────
# Permanent owner admins, comma-separated.
TENA_ADMIN_EMAILS=
# "manual": shops pay by M-Pesa and an admin confirms in /ops. "demo": fake
# self-confirming payments, for local testing only.
TENA_BILLING_MODE=manual
# Where shops send money, e.g. "Till 123456" or "Paybill 123456".
TENA_MPESA_PAY_TO=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Password resets and admin invites. Without these, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=Tena <no-reply@yourdomain.com>

# ── AI (not wired yet) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to 0 to stop loading Grok's "Created with Grok" badge script.
# VITE_GROK_EXTENSIONS=0
